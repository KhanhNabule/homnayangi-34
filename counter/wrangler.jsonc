{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "truanayangi-counter",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truanayangi-counter",
      "migrations_dir": "migrations",
      "database_id": "8965f415-cff2-4398-9e63-70fcc7bb7faf"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://nagisanzenin.github.io"
  },
  "observability": {
    "enabled": true
  }
}
